<?xml version="1.0" encoding="utf-8"?>
<!-- 文本转语音设置（v1.5.7）：单一语音库 + 语速/音调进度条；仅本应用生效，不改系统默认 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tts_settings_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tts_settings_hint"
            android:textSize="13sp"
            android:textColor="#666666"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <!-- ===== 语音库（引擎） ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tts_engine_label"
            android:textSize="15sp"
            android:textColor="#333333"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_engine"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="18dp" />

        <!-- ===== 语速 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/tts_rate_label"
                android:textSize="15sp"
                android:textColor="#333333"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_rate_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#1A73E8"
                android:text="@string/tts_rate_default" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seek_rate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <!-- ===== 音调 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/tts_pitch_label"
                android:textSize="15sp"
                android:textColor="#333333"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_pitch_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#1A73E8"
                android:text="@string/tts_pitch_default" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seek_pitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <Button
            android:id="@+id/btn_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/tts_test" />

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tts_reset" />

        <TextView
            android:id="@+id/btn_open_system"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tts_open_system_settings"
            android:textSize="13sp"
            android:textColor="#1A73E8"
            android:paddingTop="14dp"
            android:paddingBottom="8dp" />

    </LinearLayout>
</ScrollView>
