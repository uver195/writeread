<?xml version="1.0" encoding="utf-8"?>
<!-- 写读板设置页：文本转语音 / 检查更新 / 关于软件 / 帮助说明 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F7"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/item_settings_title"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:id="@+id/item_tts"
        style="@style/HomeListItem"
        android:onClick="onSettingsItemClick">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_tts"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_tts_desc"
            android:textSize="13sp"
            android:textColor="#777777"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/item_update"
        style="@style/HomeListItem"
        android:onClick="onSettingsItemClick">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_update"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_update_desc"
            android:textSize="13sp"
            android:textColor="#777777"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/item_about"
        style="@style/HomeListItem"
        android:onClick="onSettingsItemClick">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_about"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_about_desc"
            android:textSize="13sp"
            android:textColor="#777777"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/item_help"
        style="@style/HomeListItem"
        android:onClick="onSettingsItemClick">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_help"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_help_desc"
            android:textSize="13sp"
            android:textColor="#777777"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>